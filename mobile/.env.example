EXPO_PUBLIC_APP_ENV=development

# Qual API o aplicativo usa.
#   tech4hr : a API do Tech4Hr (Tech4Hr.API), a mesma do site e do banco que
#             já existe. Login do funcionário e operacional, ponto e histórico.
#   public  : a Tech4Hr.PublicApi independente (padrão, mantém o que já existia).
EXPO_PUBLIC_API_TARGET=tech4hr

# Endereço da API escolhida acima.
# Em desenvolvimento aceita http, por exemplo a API rodando no seu computador:
#   http://192.168.0.10:5287   (use o IP do computador na rede, não localhost)
# Em staging e produção precisa ser https.
EXPO_PUBLIC_API_URL=http://192.168.0.10:5287

EXPO_PUBLIC_MAINTENANCE_MODE=false
