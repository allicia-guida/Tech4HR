@model Tech4Hr.Web.Models.UsuarioCadastroInputModel

@{
    ViewData["Title"] = "Cadastrar Usuário";
}

<section class="page-section">
    <div class="page-header">
        <div>
            <a asp-controller="Usuarios" asp-action="Index" class="back-link">← Voltar para usuários</a>
            <h2>Cadastrar usuário</h2>
            <p>Crie um usuário administrativo com acesso ao painel Tech4Hr.</p>
        </div>
    </div>

    <div class="table-card user-form-card">
        <form asp-action="Cadastrar" method="post" class="auth-form user-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>

            <div class="user-form-grid">
                <div class="field-group user-field">
                    <label asp-for="Nome">Nome</label>
                    <input asp-for="Nome" />
                    <span asp-validation-for="Nome" class="validation-message"></span>
                </div>

                <div class="field-group user-field">
                    <label asp-for="Sobrenome">Sobrenome</label>
                    <input asp-for="Sobrenome" />
                    <span asp-validation-for="Sobrenome" class="validation-message"></span>
                </div>

                <div class="field-group user-field">
                    <label asp-for="Email">E-mail</label>
                    <input asp-for="Email" type="email" />
                    <span asp-validation-for="Email" class="validation-message"></span>
                </div>

                <div class="field-group user-field">
                    <label asp-for="Senha">Senha</label>
                    <input asp-for="Senha" type="password" />
                    <span asp-validation-for="Senha" class="validation-message"></span>
                </div>

                <div class="field-group user-field full-width">
                    <label asp-for="NivelUsuario">Nível de acesso</label>
                    <select asp-for="NivelUsuario">
                        <option value="">Selecione o nível</option>
                        <option value="ADMIN">ADMIN</option>
                    </select>
                    <small class="field-hint">
                        Operacionais são cadastrados em Funcionários, com o nível Operacional.
                    </small>
                    <span asp-validation-for="NivelUsuario" class="validation-message"></span>
                </div>
            </div>

            <div class="user-form-actions">
                <button type="submit" class="btn-primary">Salvar usuário</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
