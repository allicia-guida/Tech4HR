@model IReadOnlyList<Tech4Hr.Web.Models.UsuarioApiResponse>

@{
    ViewData["Title"] = "Usuários";
}

<section class="page-section">

    <div class="page-header">
        <div>
            <h1>Usuários administrativos</h1>
            <p>Gerencie os acessos e o status dos administradores do sistema.</p>
        </div>

        <a asp-controller="Usuarios"
           asp-action="Cadastrar"
           class="btn-primary">
            Cadastrar usuário
        </a>
    </div>

    @if (TempData["Erro"] is not null)
    {
        <div class="alert alert-error" role="alert">
            @TempData["Erro"]
        </div>
    }

    <div class="table-card">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                Nenhum usuário cadastrado.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Usuário</th>
                            <th>E-mail</th>
                            <th>Nível</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td class="cell-title" data-label="Usuário">
                                    <strong>@usuario.NomeCompleto</strong>
                                </td>
                                <td data-label="E-mail">@usuario.Email</td>
                                <td data-label="Nível">@usuario.NivelUsuario</td>
                                <td data-label="Status">
                                    @if (usuario.Ativo)
                                    {
                                        <span class="status-badge status-active">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inativo</span>
                                    }
                                </td>
                                <td class="cell-actions" data-label="Ações">
                                    <div class="table-actions">
                                        <a asp-controller="Usuarios"
                                           asp-action="Editar"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="btn-action btn-edit"
                                           title="Editar">
                                            <span class="btn-action-label">Editar</span>
                                        </a>

                                        <form asp-controller="Usuarios"
                                              asp-action="AlterarStatus"
                                              method="post"
                                              data-confirm-title="@(usuario.Ativo ? "Desativar usuário?" : "Ativar usuário?")"
                                              data-confirm="@(usuario.Ativo ? $"{usuario.NomeCompleto} perde o acesso ao sistema agora, mesmo que esteja logado." : $"{usuario.NomeCompleto} volta a ter acesso ao sistema.")"
                                              data-confirm-ok="@(usuario.Ativo ? "Desativar" : "Ativar")"
                                              data-confirm-danger="@(usuario.Ativo ? "true" : "false")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@usuario.IdUsuario" />
                                            <input type="hidden" name="ativo" value="@(!usuario.Ativo)" />
                                            <button type="submit"
                                                    class="btn-action @(usuario.Ativo ? "btn-action-danger" : "btn-action-secondary")"
                                                    title="@(usuario.Ativo ? "Desativar" : "Ativar")">
                                                <span class="btn-action-label">@(usuario.Ativo ? "Desativar" : "Ativar")</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</section>
