@model Tech4Hr.Web.Models.MeuPontoViewModel

@{
    ViewData["Title"] = "Meu ponto";

    var temHoraOficial = Model.ServidorEpochMs > 0;
    var ptBr = new System.Globalization.CultureInfo("pt-BR");

    var dataHoje = temHoraOficial
        ? Model.DataAtual.ToString("dddd, dd 'de' MMMM", ptBr)
        : string.Empty;

    var horaInicial = temHoraOficial
        ? Model.DataAtual.ToString("HH:mm:ss", ptBr)
        : "--:--:--";

    var registroHoje = Model.PontoHoje ?? new Tech4Hr.Web.Models.PontoApiResponse();

    var primeiroNome = (Model.NomeFuncionario ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault() ?? "Funcionário";

    // Texto do botão conforme a próxima batida que a API permite.
    var textoBotao = Model.ProximoTipoRegistro switch
    {
        "ENTRADA" => "Registrar entrada",
        "SAIDA_ALMOCO" => "Registrar saída para o almoço",
        "ENTRADA_ALMOCO" => "Registrar retorno do almoço",
        "SAIDA" => "Registrar saída",
        _ => Model.PodeRegistrarPonto ? "Registrar ponto" : "Jornada de hoje concluída"
    };

    var etapas = new[]
    {
        (Tipo: "ENTRADA", Nome: "Entrada", Hora: registroHoje.Entrada),
        (Tipo: "SAIDA_ALMOCO", Nome: "Saída para o almoço", Hora: registroHoje.SaidaAlmoco),
        (Tipo: "ENTRADA_ALMOCO", Nome: "Retorno do almoço", Hora: registroHoje.EntradaAlmoco),
        (Tipo: "SAIDA", Nome: "Saída", Hora: registroHoje.Saida)
    };
}

<div class="funcionario-page funcionario-clock-page">

    <h1 class="sr-only">Meu ponto</h1>

    <div class="clock-card">

        <div>
            <p class="clock-greeting">Olá, @primeiroNome</p>
            <p class="clock-date" id="clockDate">@dataHoje</p>
        </div>

        <div class="clock-time"
             id="clockTime"
             role="timer"
             aria-live="off"
             data-servidor-epoch="@Model.ServidorEpochMs"
             data-fuso="@Model.FusoHorario">@horaInicial</div>

        <p class="clock-label">Horário de Brasília</p>

        @if (TempData["Sucesso"] is string sucesso)
        {
            <div class="alert alert-success" role="status">@sucesso</div>
        }

        @if (TempData["Erro"] is string erro)
        {
            <div class="alert alert-error" role="alert">@erro</div>
        }

        <form asp-controller="MeuPonto"
              asp-action="RegistrarPonto"
              method="post"
              class="clock-form"
              id="registrarPontoForm">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn-registro"
                    id="btnRegistrarPonto"
                    data-loading-text="Registrando..."
                    disabled="@(Model.PodeRegistrarPonto ? null : "disabled")">
                @textoBotao
            </button>
        </form>

        <div class="registro-hoje">
            <div class="registro-hoje-header">
                <h3>Registros de hoje</h3>
            </div>

            <div class="registro-lista">
                @foreach (var etapa in etapas)
                {
                    var feito = etapa.Hora.HasValue;
                    var ehProxima = !feito && etapa.Tipo == Model.ProximoTipoRegistro;

                    <div class="registro-item @(feito ? "ok" : ehProxima ? "next" : "pending")">
                        <span>@etapa.Nome</span>
                        <strong>@(feito ? etapa.Hora!.Value.ToString("HH:mm") : "--:--")</strong>
                    </div>
                }
            </div>
        </div>

        <div class="history-action">
            <a asp-controller="MeuPonto"
               asp-action="Historico"
               class="btn-historico">
                Ver meu histórico
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const element = document.getElementById('clockTime');
            if (!element) return;

            const elementoData = document.getElementById('clockDate');
            const fuso = element.dataset.fuso || 'America/Sao_Paulo';
            const servidor = Number(element.dataset.servidorEpoch) || 0;

            // Diferença entre a hora oficial da API e o relógio do aparelho,
            // medida uma vez ao carregar. Assim um aparelho com a hora errada
            // ou em outro fuso continua mostrando o horário de Brasília.
            const diferenca = servidor > 0 ? servidor - Date.now() : 0;

            const formatoHora = new Intl.DateTimeFormat('pt-BR', {
                timeZone: fuso,
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                hourCycle: 'h23'
            });

            const formatoData = new Intl.DateTimeFormat('pt-BR', {
                timeZone: fuso,
                weekday: 'long',
                day: '2-digit',
                month: 'long'
            });

            const atualizarRelogio = () => {
                const agora = new Date(Date.now() + diferenca);
                element.textContent = formatoHora.format(agora);

                if (elementoData) {
                    elementoData.textContent = formatoData.format(agora);
                }
            };

            atualizarRelogio();
            setInterval(atualizarRelogio, 1000);
        })();
    </script>
}
