@model Tech4Hr.Web.Models.HistoricoMeuPontoViewModel

@{
    ViewData["Title"] = "Meu histórico";

    static string Hora(DateTime? horario) =>
        horario.HasValue ? horario.Value.ToString("HH:mm") : "--";
}

<div class="funcionario-page funcionario-page-wide funcionario-historico-page">

    <div class="funcionario-header">
        <h1>Meu histórico</h1>
        <a asp-controller="MeuPonto" asp-action="Index" class="btn-secondary compact">
            Voltar para meu ponto
        </a>
    </div>

    @if (TempData["Erro"] is string erro)
    {
        <div class="alert alert-error" role="alert">@erro</div>
    }

    <div class="filters-card compact-card">
        <form method="get" class="filter-form history-form">
            <div class="field-group">
                <label for="dataInicio">Data inicial</label>
                <input type="date" id="dataInicio" name="dataInicio" value="@(Model.DataInicio.HasValue ? Model.DataInicio.Value.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <div class="field-group">
                <label for="dataFim">Data final</label>
                <input type="date" id="dataFim" name="dataFim" value="@(Model.DataFim.HasValue ? Model.DataFim.Value.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <button type="submit" class="btn-primary history-submit">
                Filtrar
            </button>
        </form>
    </div>

    <div class="table-card">
        @if (Model.Registros.Count == 0)
        {
            <p class="empty-state">Nenhum registro encontrado no período.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Entrada</th>
                            <th>Saída almoço</th>
                            <th>Retorno</th>
                            <th>Saída</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ponto in Model.Registros)
                        {
                            <tr>
                                <td class="cell-title" data-label="Data"><strong>@ponto.DataPonto.ToString("dd/MM/yyyy")</strong></td>
                                <td data-label="Entrada">@Hora(ponto.Entrada)</td>
                                <td data-label="Saída almoço">@Hora(ponto.SaidaAlmoco)</td>
                                <td data-label="Retorno">@Hora(ponto.EntradaAlmoco)</td>
                                <td data-label="Saída">@Hora(ponto.Saida)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>
