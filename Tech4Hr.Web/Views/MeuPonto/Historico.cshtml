@model Tech4Hr.Web.Models.HistoricoMeuPontoViewModel

@{
    ViewData["Title"] = "Meu histórico";
}

<div class="funcionario-page funcionario-historico-page">
    <div class="funcionario-header">
        <div>
            <p class="eyebrow">Histórico</p>
            <h2>Meu histórico</h2>
        </div>
        <a asp-controller="MeuPonto" asp-action="Index" class="btn-secondary compact">Voltar</a>
    </div>

    @if (TempData["Erro"] is string erro)
    {
        <div class="alert danger">@erro</div>
    }

    <div class="filters-card compact-card">
        <form method="get" class="filter-form history-form">
            <div class="field-group">
                <label>Data inicial</label>
                <input type="date" name="dataInicio" value="@(Model.DataInicio.HasValue ? Model.DataInicio.Value.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <div class="field-group">
                <label>Data final</label>
                <input type="date" name="dataFim" value="@(Model.DataFim.HasValue ? Model.DataFim.Value.ToString("yyyy-MM-dd") : string.Empty)" />
            </div>
            <button type="submit" class="btn-login-submit history-submit">Filtrar</button>
        </form>
    </div>

    <div class="table-card">
        @if (Model.Registros.Count == 0)
        {
            <p class="empty-state">Nenhum registro encontrado no período.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Entrada</th>
                            <th>Saída almoço</th>
                            <th>Retorno</th>
                            <th>Saída</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ponto in Model.Registros)
                        {
                            <tr>
                                <td>@ponto.DataPonto.ToString("dd/MM/yyyy")</td>
                                <td>@(ponto.Entrada.HasValue ? ponto.Entrada.Value.ToString("HH:mm") : "--")</td>
                                <td>@(ponto.SaidaAlmoco.HasValue ? ponto.SaidaAlmoco.Value.ToString("HH:mm") : "--")</td>
                                <td>@(ponto.EntradaAlmoco.HasValue ? ponto.EntradaAlmoco.Value.ToString("HH:mm") : "--")</td>
                                <td>@(ponto.Saida.HasValue ? ponto.Saida.Value.ToString("HH:mm") : "--")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
