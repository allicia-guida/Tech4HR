@model Tech4Hr.Web.Models.FuncionarioEdicaoInputModel

@{
    ViewData["Title"] = "Editar funcionário";

    var ehAdmin = string.Equals(
        Context.Session.GetString("UsuarioNivel"),
        "ADMIN",
        StringComparison.OrdinalIgnoreCase);
}

<section class="page-section">
    <div class="page-header">
        <div>
            <a asp-controller="Funcionarios" asp-action="Index" class="back-link">
                <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
                Voltar para funcionários
            </a>
            <h1>Editar funcionário</h1>
            <p>Atualize os dados do funcionário conforme o cadastro atual do sistema.</p>
        </div>
    </div>

    <div class="funcionario-form-card">
        <form asp-action="Editar" method="post" class="auth-form funcionario-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>

            <div class="funcionario-form-grid">
                <div class="field-group funcionario-field">
                    <label asp-for="Nome">Nome</label>
                    <input asp-for="Nome" autocomplete="off" />
                    <span asp-validation-for="Nome" class="validation-message"></span>
                </div>

                <div class="field-group funcionario-field">
                    <label asp-for="Sobrenome">Sobrenome</label>
                    <input asp-for="Sobrenome" autocomplete="off" />
                    <span asp-validation-for="Sobrenome" class="validation-message"></span>
                </div>

                <div class="field-group funcionario-field full-width">
                    <label asp-for="EmailCorporativo">E-mail corporativo</label>
                    <input asp-for="EmailCorporativo" type="email" inputmode="email" autocapitalize="none" autocomplete="off" />
                    <span asp-validation-for="EmailCorporativo" class="validation-message"></span>
                </div>

                <div class="field-group funcionario-field">
                    <label asp-for="CPF">CPF</label>
                    <input asp-for="CPF" inputmode="numeric" maxlength="11" pattern="[0-9]*" autocomplete="off" />
                    <span asp-validation-for="CPF" class="validation-message"></span>
                </div>

                <div class="field-group funcionario-field">
                    <label asp-for="DataAdmissao">Data de admissão</label>
                    <input asp-for="DataAdmissao" type="date" />
                    <span asp-validation-for="DataAdmissao" class="validation-message"></span>
                </div>

                @if (ehAdmin)
                {
                    <div class="field-group funcionario-field full-width">
                        <label asp-for="NivelAcesso">Nível de acesso</label>
                        <select asp-for="NivelAcesso">
                            <option value="FUNCIONARIO">Funcionário</option>
                            <option value="OPERACIONAL">Operacional (também gere funcionários e consulta pontos)</option>
                        </select>
                        <span asp-validation-for="NivelAcesso" class="validation-message"></span>
                    </div>
                }
            </div>

            <div class="user-form-actions">
                <a asp-controller="Funcionarios" asp-action="Index" class="btn-secondary">Cancelar</a>
                <button type="submit" class="btn-primary" data-loading-text="Salvando...">Salvar alterações</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
