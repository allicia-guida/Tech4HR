@model IReadOnlyList<Tech4Hr.Web.Models.FuncionarioApiResponse>

@{
    ViewData["Title"] = "Funcionários";

    var ehAdmin = string.Equals(
        Context.Session.GetString("UsuarioNivel"),
        "ADMIN",
        StringComparison.OrdinalIgnoreCase);
}

<section class="page-section">

    <div class="page-header">
        <div>
            <h2>Funcionários cadastrados</h2>
            <p>
                Consulte e gerencie os dados dos funcionários cadastrados no sistema.
            </p>
        </div>

        <a asp-controller="Funcionarios"
           asp-action="Cadastrar"
           class="btn-primary">
            <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
            Cadastrar funcionário
        </a>
    </div>

    @if (TempData["Sucesso"] is not null)
    {
        <div class="alert alert-success" role="status">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] is not null)
    {
        <div class="alert alert-error" role="alert">
            @TempData["Erro"]
        </div>
    }

    <div class="table-card">

        <div class="table-toolbar">
            <input type="search"
                   id="buscaFuncionario"
                   placeholder="Buscar funcionário..."
                   aria-label="Buscar funcionário"
                   class="search-input" />

            <select id="filtroStatusFuncionario" class="search-input" aria-label="Filtrar por status">
                <option value="todos">Todos</option>
                <option value="ativos">Ativos</option>
                <option value="inativos">Inativos</option>
            </select>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                Nenhum funcionário cadastrado.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="data-table"
                       id="tabelaFuncionarios">

                    <thead>
                        <tr>
                            <th>Funcionário</th>
                            <th>E-mail</th>
                            <th class="col-secundaria">CPF</th>
                            <th class="col-secundaria">Admissão</th>
                            <th>Perfil</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var funcionario in Model)
                        {
                            <tr data-status="@(funcionario.Ativo ? "ativo" : "inativo")">

                                <td class="cell-title" data-label="Funcionário">
                                    <strong>@funcionario.NomeCompleto</strong>
                                </td>

                                <td data-label="E-mail">@funcionario.EmailCorporativo</td>

                                <td class="col-secundaria" data-label="CPF">@funcionario.CPF</td>

                                <td class="col-secundaria" data-label="Admissão">
                                    @funcionario.DataAdmissao.ToString("dd/MM/yyyy")
                                </td>

                                <td data-label="Perfil">
                                    @(funcionario.EhOperacional ? "Operacional" : "Funcionário")
                                </td>

                                <td data-label="Status">
                                    @if (funcionario.Ativo)
                                    {
                                        <span class="status-badge status-active">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inativo</span>
                                    }
                                </td>

                                <td class="cell-actions" data-label="Ações">
                                    <div class="table-actions">

                                        <a asp-controller="Funcionarios"
                                           asp-action="Detalhes"
                                           asp-route-id="@funcionario.IdFuncionario"
                                           class="btn-action btn-action-view"
                                           title="Visualizar">
                                            <svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>
                                            <span class="btn-action-label">Visualizar</span>
                                        </a>

                                        <a asp-controller="Funcionarios"
                                           asp-action="Editar"
                                           asp-route-id="@funcionario.IdFuncionario"
                                           class="btn-action btn-action-secondary"
                                           title="Editar">
                                            <svg class="icon" aria-hidden="true"><use href="#i-edit" /></svg>
                                            <span class="btn-action-label">Editar</span>
                                        </a>

                                        @if (ehAdmin)
                                        {
                                            <form asp-controller="Funcionarios"
                                                  asp-action="AlterarStatus"
                                                  method="post"
                                                  data-confirm-title="@(funcionario.Ativo ? "Desativar funcionário?" : "Ativar funcionário?")"
                                                  data-confirm="@(funcionario.Ativo ? $"{funcionario.NomeCompleto} perde o acesso ao sistema até ser ativado novamente." : $"{funcionario.NomeCompleto} volta a ter acesso ao sistema.")"
                                                  data-confirm-ok="@(funcionario.Ativo ? "Desativar" : "Ativar")"
                                                  data-confirm-danger="@(funcionario.Ativo ? "true" : "false")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@funcionario.IdFuncionario" />
                                                <input type="hidden" name="ativo" value="@(!funcionario.Ativo)" />
                                                <button type="submit"
                                                        class="btn-action @(funcionario.Ativo ? "btn-action-danger" : "btn-action-secondary")"
                                                        title="@(funcionario.Ativo ? "Desativar" : "Ativar")">
                                                    <svg class="icon" aria-hidden="true"><use href="#i-power" /></svg>
                                                    <span class="btn-action-label">@(funcionario.Ativo ? "Desativar" : "Ativar")</span>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>
