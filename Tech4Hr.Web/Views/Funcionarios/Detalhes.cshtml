@model Tech4Hr.Web.Models.FuncionarioApiResponse

@{
    ViewData["Title"] = "Dados do funcionário";
}

<section class="page-section">

    <div class="page-header">

        <div>
            <a asp-controller="Funcionarios"
               asp-action="Index"
               class="back-link">
                ← Voltar para funcionários
            </a>

            <h2>@Model.NomeCompleto</h2>

            <p>
                Consulte os dados cadastrais e os registros
                de ponto deste funcionário.
            </p>
        </div>

        <a asp-controller="Funcionarios"
           asp-action="Editar"
           asp-route-id="@Model.IdFuncionario"
           class="btn-primary">
            Editar dados
        </a>

    </div>

    <div class="employee-details-card">

        <div class="employee-details-header">

            <div>
                <span class="details-label">
                    Funcionário
                </span>

                <h3>@Model.NomeCompleto</h3>
            </div>

            @if (Model.Ativo)
            {
                <span class="status-badge status-active">
                    Ativo
                </span>
            }
            else
            {
                <span class="status-badge status-inactive">
                    Inativo
                </span>
            }

        </div>

        <div class="employee-details-grid">

            <div class="detail-item">
                <span>E-mail corporativo</span>
                <strong>@Model.EmailCorporativo</strong>
            </div>

            <div class="detail-item">
                <span>CPF</span>
                <strong>@Model.CPF</strong>
            </div>

            <div class="detail-item">
                <span>Data de admissão</span>
                <strong>
                    @Model.DataAdmissao.ToString("dd/MM/yyyy")
                </strong>
            </div>

            <div class="detail-item">
                <span>ID do funcionário</span>
                <strong>@Model.IdFuncionario</strong>
            </div>

        </div>

    </div>

    <div class="employee-points-placeholder">

        <div>
            <span class="details-label">
                Registros
            </span>

            <h3>Pontos registrados</h3>
        </div>

        <p>
            Os registros de ponto deste funcionário serão
            exibidos aqui.
        </p>

    </div>

</section>