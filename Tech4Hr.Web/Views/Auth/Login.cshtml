@model Tech4Hr.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - Tech4Hr</title>

    <link rel="stylesheet"
          href="~/css/tech4hr.css"
          asp-append-version="true" />
</head>

<body class="auth-page">

    <main class="auth-card">

        <div class="auth-brand">Tech4Hr</div>

        <h2>Login</h2>

        <p class="auth-text">
            Acesse sua conta para gerenciar funcionários,
            usuários e registros de ponto.
        </p>

        <form asp-controller="Auth"
              asp-action="Login"
              method="post"
              class="auth-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>

            <input asp-for="Email"
                   type="email"
                   placeholder="E-mail"
                   autocomplete="email"
                   required />

            <span asp-validation-for="Email"
                  class="validation-message">
            </span>

            <input asp-for="Senha"
                   type="password"
                   placeholder="Senha"
                   autocomplete="current-password"
                   required />

            <span asp-validation-for="Senha"
                  class="validation-message">
            </span>

            <button type="submit">
                Entrar
            </button>

        </form>

        <p class="auth-link-text">
            O cadastro de usuários é realizado por um administrador dentro do sistema.
        </p>

    </main>

</body>
</html>