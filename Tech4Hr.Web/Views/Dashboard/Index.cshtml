@model Tech4Hr.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Painel";

    var ehAdmin = string.Equals(
        Context.Session.GetString("UsuarioNivel"),
        "ADMIN",
        StringComparison.OrdinalIgnoreCase);
}

<section class="page-section">

    @if (TempData["Erro"] is not null)
    {
        <div class="alert alert-error" role="alert">
            @TempData["Erro"]
        </div>
    }

    <div class="page-header">
        <div>
            <h1>@(ehAdmin ? "Visão geral administrativa" : "Resumo operacional")</h1>
            <p>@(ehAdmin ? "Resumo do sistema Tech4Hr." : "Dados gerais da operação e da equipe.")</p>
        </div>

        <div class="filter-actions">
            <a asp-controller="Pontos" asp-action="Index" class="btn-secondary">
                Ver pontos
            </a>
            <a asp-controller="Funcionarios" asp-action="Cadastrar" class="btn-primary">
                Cadastrar funcionário
            </a>
        </div>
    </div>

    <div class="summary-grid">

        <section class="summary-card" aria-labelledby="resumoFuncionarios">
            <div class="summary-card-header">
                <h2 id="resumoFuncionarios">Funcionários</h2>
                <a asp-controller="Funcionarios" asp-action="Index">Ver lista</a>
            </div>

            <dl class="summary-list">
                <div class="summary-row">
                    <dt>Cadastrados</dt>
                    <dd>@Model.TotalFuncionarios</dd>
                </div>
                <div class="summary-row">
                    <dt>Ativos</dt>
                    <dd>@Model.FuncionariosAtivos</dd>
                </div>
                <div class="summary-row">
                    <dt>Operacionais</dt>
                    <dd>@Model.TotalOperacionais</dd>
                </div>
            </dl>
        </section>

        @if (ehAdmin)
        {
            <section class="summary-card" aria-labelledby="resumoUsuarios">
                <div class="summary-card-header">
                    <h2 id="resumoUsuarios">Usuários administrativos</h2>
                    <a asp-controller="Usuarios" asp-action="Index">Ver lista</a>
                </div>

                <dl class="summary-list">
                    <div class="summary-row">
                        <dt>Cadastrados</dt>
                        <dd>@Model.TotalUsuarios</dd>
                    </div>
                    <div class="summary-row">
                        <dt>Ativos</dt>
                        <dd>@Model.UsuariosAtivos</dd>
                    </div>
                    <div class="summary-row">
                        <dt>Administradores</dt>
                        <dd>@Model.TotalAdministradores</dd>
                    </div>
                </dl>
            </section>
        }

    </div>

    @if (Model.Graficos is { } graficos)
    {
        <section class="charts-grid" aria-labelledby="titulo-graficos">

            <h2 id="titulo-graficos" class="sr-only">Gráficos</h2>

            @if (graficos.Hoje is not null)
            {
                <partial name="_GraficoBarra" model="graficos.Hoje" />
            }

            @if (graficos.Equipe is not null)
            {
                <partial name="_GraficoBarra" model="graficos.Equipe" />
            }

            @if (graficos.Dias is not null)
            {
                <partial name="_GraficoColunas" model="graficos.Dias" />
            }

            @if (graficos.Aviso is not null)
            {
                <div class="alert alert-error chart-aviso" role="status">@graficos.Aviso</div>
            }

        </section>
    }

</section>
