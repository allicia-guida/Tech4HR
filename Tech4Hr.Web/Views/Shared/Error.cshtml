@model ErrorViewModel

@{
    ViewData["Title"] = "Algo deu errado";
}

<section class="page-section">
    <div class="page-header">
        <div>
            <h1>Algo deu errado</h1>
            <p>Não foi possível concluir a sua solicitação. Tente novamente em instantes.</p>
        </div>
    </div>

    <div class="alert alert-error" role="alert">
        Se o problema continuar, informe o código abaixo a quem administra o sistema.
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="field-hint">Código da solicitação: <code>@Model.RequestId</code></p>
    }

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn-primary">Voltar ao início</a>
    </div>
</section>
