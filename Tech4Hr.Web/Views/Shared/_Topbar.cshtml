@{
    var titulo = ViewData["Title"]?.ToString() ?? "Tech4Hr";

    var nivelUsuario =
        Context.Session.GetString("UsuarioNivel");
}

<header class="topbar">

    <div>
        <p class="topbar-label">
            Tech4Hr
        </p>

        <h1>@titulo</h1>
    </div>

    <div class="topbar-actions">
        <button type="button"
                id="toggle-acessibilidade"
                class="topbar-access-btn"
                aria-pressed="false"
                title="Ativar contraste suave">
            👁️
        </button>

        <div class="topbar-profile">
            <span>
                @nivelUsuario
            </span>
        </div>
    </div>

</header>