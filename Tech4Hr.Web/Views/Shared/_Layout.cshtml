<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171c23" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Tech4Hr: gestão de funcionários e controle de ponto." />

    <title>@ViewData["Title"] - Tech4Hr</title>

    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/img/tech4hr-icon.svg" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Tech4Hr" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="stylesheet"
          href="~/css/tech4hr.css"
          asp-append-version="true" />

    @* Aplica o modo para daltônicos antes da primeira pintura, sem piscar. *@
    <script>
        try {
            if (localStorage.getItem('tech4hr-contraste') === 'true') {
                document.documentElement.classList.add('accessibility-daltonic');
            }
        } catch (e) { }
    </script>
</head>

<body class="app-page">

    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <partial name="_Icons" />

    <div class="app-shell">

        <partial name="_Cabecalho" />

        <main id="conteudo" class="content-area">
            @RenderBody()
        </main>

    </div>

    <script src="~/js/tech4hr.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
