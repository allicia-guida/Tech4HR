@{
    var controllerAtual =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var acaoAtual =
        ViewContext.RouteData.Values["action"]?.ToString();

    var tipoConta =
        Context.Session.GetString("TipoConta");

    var funcionarioLogado =
        string.Equals(tipoConta, "FUNCIONARIO", StringComparison.OrdinalIgnoreCase);

    var nome = funcionarioLogado
        ? Context.Session.GetString("FuncionarioNome")
        : Context.Session.GetString("UsuarioNome");

    // Telas de gestão: ADMIN e OPERACIONAL. O operacional também é funcionário,
    // então vê "Meu ponto" e as telas de gestão no mesmo menu.
    var nivelGestao =
        Context.Session.GetString("UsuarioNivel");

    var ehAdmin =
        string.Equals(nivelGestao, "ADMIN", StringComparison.OrdinalIgnoreCase);

    var temGestao =
        ehAdmin ||
        string.Equals(nivelGestao, "OPERACIONAL", StringComparison.OrdinalIgnoreCase);

    var perfil = ehAdmin
        ? "Administrador"
        : temGestao
            ? "Operacional"
            : "Funcionário";

    string Ativo(string controller, string? acao = null) =>
        controllerAtual == controller && (acao is null || acaoAtual == acao) ? "active" : "";

    string Atual(string controller, string? acao = null) =>
        controllerAtual == controller && (acao is null || acaoAtual == acao) ? "page" : "false";
}

<header class="app-header">

    <div class="app-header-inner">

        <a asp-controller="Home"
           asp-action="Index"
           class="brand"
           aria-label="Tech4Hr, página inicial">Tech4Hr</a>

        <nav class="main-nav" aria-label="Menu principal">

            @if (funcionarioLogado)
            {
                <a asp-controller="MeuPonto"
                   asp-action="Index"
                   class="nav-link @Ativo("MeuPonto", "Index")"
                   aria-current="@Atual("MeuPonto", "Index")">
                    <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>
                    <span class="nav-link-text">Meu ponto</span>
                </a>

                <a asp-controller="MeuPonto"
                   asp-action="Historico"
                   class="nav-link @Ativo("MeuPonto", "Historico")"
                   aria-current="@Atual("MeuPonto", "Historico")">
                    <svg class="icon" aria-hidden="true"><use href="#i-history" /></svg>
                    <span class="nav-link-text">Histórico</span>
                </a>
            }

            @if (temGestao)
            {
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-link @Ativo("Dashboard")"
                   aria-current="@Atual("Dashboard")">
                    <svg class="icon" aria-hidden="true"><use href="#i-dashboard" /></svg>
                    <span class="nav-link-text">Painel</span>
                </a>

                <a asp-controller="Funcionarios"
                   asp-action="Index"
                   class="nav-link @Ativo("Funcionarios")"
                   aria-current="@Atual("Funcionarios")">
                    <svg class="icon" aria-hidden="true"><use href="#i-users" /></svg>
                    <span class="nav-link-text">Funcionários</span>
                </a>

                <a asp-controller="Pontos"
                   asp-action="Index"
                   class="nav-link @Ativo("Pontos")"
                   aria-current="@Atual("Pontos")">
                    <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>
                    <span class="nav-link-text">Pontos</span>
                </a>

                @if (ehAdmin)
                {
                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="nav-link @Ativo("Usuarios")"
                       aria-current="@Atual("Usuarios")">
                        <svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg>
                        <span class="nav-link-text">Usuários</span>
                    </a>
                }
            }

        </nav>

        <div class="header-tools">

            <button type="button"
                    id="toggle-acessibilidade"
                    class="tool-btn"
                    aria-pressed="false"
                    aria-label="Ativar modo de contraste para daltonismo"
                    title="Modo de contraste para daltonismo">
                <svg class="icon tool-icon" aria-hidden="true"><use href="#i-contrast" /></svg>
                <span class="tool-label">Daltonismo</span>
            </button>

            <div class="user-box">
                <span class="user-name">@(string.IsNullOrWhiteSpace(nome) ? "Usuário" : nome)</span>
                <span class="user-role">@perfil</span>
            </div>

            <form asp-controller="Auth"
                  asp-action="Logout"
                  method="post"
                  class="header-logout">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="tool-btn"
                        aria-label="Sair"
                        title="Sair">
                    <svg class="icon tool-icon" aria-hidden="true"><use href="#i-logout" /></svg>
                    <span class="tool-label">Sair</span>
                </button>
            </form>

        </div>

    </div>

</header>
