@{
    var controllerAtual =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var acaoAtual =
        ViewContext.RouteData.Values["action"]?.ToString();

    var tipoConta =
        Context.Session.GetString("TipoConta");

    var funcionarioLogado =
        string.Equals(tipoConta, "FUNCIONARIO", StringComparison.OrdinalIgnoreCase);

    var nomeUsuario =
        funcionarioLogado
            ? Context.Session.GetString("FuncionarioNome")
            : Context.Session.GetString("UsuarioNome");

    var nomeExibicao =
        string.IsNullOrWhiteSpace(nomeUsuario)
            ? "usuário"
            : nomeUsuario;

    // Telas de gestão: ADMIN e OPERACIONAL. O operacional também é funcionário,
    // então vê "Meu ponto" e as telas de gestão no mesmo menu.
    var nivelGestao =
        Context.Session.GetString("UsuarioNivel");

    var ehAdmin =
        string.Equals(nivelGestao, "ADMIN", StringComparison.OrdinalIgnoreCase);

    var temGestao =
        ehAdmin ||
        string.Equals(nivelGestao, "OPERACIONAL", StringComparison.OrdinalIgnoreCase);

    string Ativo(string controller, string? acao = null) =>
        controllerAtual == controller && (acao is null || acaoAtual == acao) ? "active" : "";

    string Atual(string controller, string? acao = null) =>
        controllerAtual == controller && (acao is null || acaoAtual == acao) ? "page" : "false";
}

<aside class="sidebar">

    <div class="sidebar-brand">
        <span class="brand-mark"><svg class="icon" aria-hidden="true"><use href="#i-brand" /></svg></span>
        <span>Tech4Hr</span>
    </div>

    <nav class="sidebar-menu" aria-label="Menu principal">

        @if (funcionarioLogado)
        {
            <a asp-controller="MeuPonto"
               asp-action="Index"
               class="menu-item @Ativo("MeuPonto", "Index")"
               aria-current="@Atual("MeuPonto", "Index")">
                <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>
                <span class="menu-item-text">Meu ponto</span>
            </a>

            <a asp-controller="MeuPonto"
               asp-action="Historico"
               class="menu-item @Ativo("MeuPonto", "Historico")"
               aria-current="@Atual("MeuPonto", "Historico")">
                <svg class="icon" aria-hidden="true"><use href="#i-history" /></svg>
                <span class="menu-item-text">Histórico</span>
            </a>
        }

        @if (temGestao)
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="menu-item @Ativo("Dashboard")"
               aria-current="@Atual("Dashboard")">
                <svg class="icon" aria-hidden="true"><use href="#i-dashboard" /></svg>
                <span class="menu-item-text">Dashboard</span>
            </a>

            <a asp-controller="Funcionarios"
               asp-action="Index"
               class="menu-item @Ativo("Funcionarios")"
               aria-current="@Atual("Funcionarios")">
                <svg class="icon" aria-hidden="true"><use href="#i-users" /></svg>
                <span class="menu-item-text">Funcionários</span>
            </a>

            <a asp-controller="Pontos"
               asp-action="Index"
               class="menu-item @Ativo("Pontos")"
               aria-current="@Atual("Pontos")">
                <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg>
                <span class="menu-item-text">Pontos</span>
            </a>

            @if (ehAdmin)
            {
                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="menu-item @Ativo("Usuarios")"
                   aria-current="@Atual("Usuarios")">
                    <svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg>
                    <span class="menu-item-text">Usuários</span>
                </a>
            }
        }

    </nav>

    <div class="usuario-area sidebar-user">

        <div class="usuario-greeting">
            Olá, @nomeExibicao!
        </div>

        <form asp-controller="Auth"
              asp-action="Logout"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn-logout">
                <svg class="icon" aria-hidden="true"><use href="#i-logout" /></svg>
                Sair
            </button>

        </form>

    </div>

</aside>
