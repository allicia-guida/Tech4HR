@{
    var controllerAtual =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var nivelUsuario =
        Context.Session.GetString("UsuarioNivel");

    var nomeUsuario =
        Context.Session.GetString("UsuarioNome");

    var nomeExibicao =
        string.IsNullOrWhiteSpace(nomeUsuario)
            ? "usuário"
            : nomeUsuario;
}

<aside class="sidebar">

    <div>

        <div class="sidebar-brand">
            Tech4Hr
        </div>

        <nav class="sidebar-menu">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="menu-item @(controllerAtual == "Dashboard" ? "active" : "")">
                Dashboard
            </a>

            <a asp-controller="Funcionarios"
               asp-action="Index"
               class="menu-item @(controllerAtual == "Funcionarios" ? "active" : "")">
                Dados dos funcionários
            </a>

            <a asp-controller="Pontos"
               asp-action="Index"
               class="menu-item @(controllerAtual == "Pontos" ? "active" : "")">
                Pontos registrados
            </a>

            @if (nivelUsuario == "ADMIN")
            {
                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="menu-item @(controllerAtual == "Usuarios" ? "active" : "")">
                    Usuários
                </a>
            }

        </nav>

    </div>

    <div class="usuario-area sidebar-user">

        <div class="usuario-greeting">
            Olá, @nomeExibicao!
        </div>

        <form asp-controller="Auth"
              asp-action="Logout"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn-logout">
                Sair
            </button>

        </form>

    </div>

</aside>