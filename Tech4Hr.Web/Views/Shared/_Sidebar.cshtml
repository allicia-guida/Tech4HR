@{
    var controllerAtual =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var tipoConta =
        Context.Session.GetString("TipoConta");

    var funcionarioLogado =
        string.Equals(tipoConta, "FUNCIONARIO", StringComparison.OrdinalIgnoreCase);

    var nomeUsuario =
        funcionarioLogado
            ? Context.Session.GetString("FuncionarioNome")
            : Context.Session.GetString("UsuarioNome");

    var nomeExibicao =
        string.IsNullOrWhiteSpace(nomeUsuario)
            ? "usuário"
            : nomeUsuario;

    // Telas de gestão: ADMIN e OPERACIONAL. O operacional também é funcionário,
    // então vê "Meu ponto" e as telas de gestão no mesmo menu.
    var nivelGestao =
        Context.Session.GetString("UsuarioNivel");

    var ehAdmin =
        string.Equals(nivelGestao, "ADMIN", StringComparison.OrdinalIgnoreCase);

    var temGestao =
        ehAdmin ||
        string.Equals(nivelGestao, "OPERACIONAL", StringComparison.OrdinalIgnoreCase);
}

<aside class="sidebar">

    <div>

        <div class="sidebar-brand">
            Tech4Hr
        </div>

        <nav class="sidebar-menu">

            @if (funcionarioLogado)
            {
                <a asp-controller="MeuPonto"
                   asp-action="Index"
                   class="menu-item @(controllerAtual == "MeuPonto" ? "active" : "")">
                    Meu ponto
                </a>
            }

            @if (temGestao)
            {
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="menu-item @(controllerAtual == "Dashboard" ? "active" : "")">
                    Dashboard
                </a>

                <a asp-controller="Funcionarios"
                   asp-action="Index"
                   class="menu-item @(controllerAtual == "Funcionarios" ? "active" : "")">
                    Dados dos funcionários
                </a>

                <a asp-controller="Pontos"
                   asp-action="Index"
                   class="menu-item @(controllerAtual == "Pontos" ? "active" : "")">
                    Pontos registrados
                </a>

                @if (ehAdmin)
                {
                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="menu-item @(controllerAtual == "Usuarios" ? "active" : "")">
                        Usuários
                    </a>
                }
            }

        </nav>

    </div>

    <div class="usuario-area sidebar-user">

        <div class="usuario-greeting">
            Olá, @nomeExibicao!
        </div>

        <form asp-controller="Auth"
              asp-action="Logout"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn-logout">
                Sair
            </button>

        </form>

    </div>

</aside>